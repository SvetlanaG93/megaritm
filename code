<title>MegaRITM</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Golos+Text:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Unbounded:wght@500;700&display=swap">
<style>
/* Layout: one long page. Hero pairs the title with a live decision tree where offers flow and get cut at nodes (the product's own picture). Then task, work done, numbers drawn to scale, parallel run, product screens, engine, timeline, team. */
:root{
  /* committed dark look: deep ink-blue ground, MegaFon green as the single signal colour, violet only for contrast */
  --bg:#0B0E14; --surface:#131824; --ink:#EEF1F7; --muted:#9AA4B8; --line:#262E3F;
  --green:#19C96B; --green-ink:#3EE28A; --green-soft:#0F2E21; --on-green:#04140B;
  --purple:#8E6AD8; --purple-ink:#B7A0F2; --purple-soft:#241B3D;
  --alert:#FF7A5E; --ghost:#556079;
  --n-root:#8E3A9A; --n-orange:#EF5B3C; --n-purple:#5A3A99; --n-green:#11B85E;
  --tree-line:#3B4560; --spark:#7CF5B1;
  --f-display:'Unbounded','Montserrat','Arial Black',sans-serif;
  --f-body:'Golos Text','Segoe UI',Roboto,Arial,sans-serif;
  --f-mono:'JetBrains Mono',ui-monospace,Menlo,Consolas,monospace;
  color-scheme:dark;
}

*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{background-color:var(--bg);background-image:radial-gradient(60rem 34rem at 88% -8%,rgba(25,201,107,.16),transparent 62%),radial-gradient(48rem 30rem at -8% 14%,rgba(110,63,181,.20),transparent 62%);background-repeat:no-repeat;color:var(--ink);font-family:var(--f-body);font-size:16px;line-height:1.55;-webkit-font-smoothing:antialiased}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:30;background:var(--bg)}
a{color:inherit}
:focus-visible{outline:2px solid var(--green);outline-offset:2px}
.wrap{max-width:1180px;margin:0 auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.mono{font-family:var(--f-mono)}
.eyebrow{font-family:var(--f-mono);font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--green-ink);margin:0 0 14px}
h1,h2,h3{margin:0;text-wrap:balance}
h2{font-family:var(--f-display);font-weight:500;font-size:clamp(1.4rem,2.8vw,2.05rem);line-height:1.18;letter-spacing:-.015em;max-width:26ch}
h3{font-size:1.05rem;font-weight:600;line-height:1.3}
p{margin:0}
.lead{font-size:1.1rem;max-width:62ch;color:var(--ink)}
.muted{color:var(--muted)}
.s{border-top:1px solid var(--line);padding-block:clamp(48px,8vw,96px)}
.s > .wrap > .head{display:grid;gap:14px;margin-bottom:clamp(28px,4vw,48px)}

/* header */
.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:var(--bg);background:rgba(11,14,20,.82);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
.top .wrap{display:flex;align-items:center;justify-content:space-between;gap:16px;padding-block:10px}
.brand{font-family:var(--f-display);font-weight:700;font-size:1rem;text-decoration:none;display:flex;align-items:center;gap:8px}
.brand i{width:10px;height:10px;border-radius:50%;background:var(--green);display:inline-block}
.nav{display:flex;gap:22px;font-size:14px}
.nav a{text-decoration:none;color:var(--muted)}
.nav a:hover{color:var(--ink)}
.seg{display:flex;border:1px solid var(--line);border-radius:6px;overflow:hidden}
.seg button{font:500 12px var(--f-mono);letter-spacing:.06em;background:transparent;color:var(--muted);border:0;padding:6px 10px;cursor:pointer}
.seg button[aria-pressed="true"]{background:var(--green);color:var(--on-green)}
@media(max-width:860px){.nav{display:none}}

/* hero */
.hero{padding-block:clamp(28px,5vw,64px) clamp(36px,5vw,64px)}
.hero-grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:clamp(28px,4vw,56px);align-items:center}
@media(max-width:920px){.hero-grid{grid-template-columns:minmax(0,1fr)}}
.chip{display:inline-block;font:500 11.5px/1.45 var(--f-mono);letter-spacing:.05em;text-transform:uppercase;color:var(--muted);border:1px solid var(--line);border-radius:4px;padding:6px 10px;margin-bottom:22px}
h1{font-family:var(--f-display);font-weight:700;font-size:clamp(2rem,4.5vw,3.5rem);line-height:1.08;letter-spacing:-.025em}
.hero .lead{margin-top:22px}
.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin-top:34px;border-top:1px solid var(--line)}
.stat{padding:14px 14px 0 0}
.stat b{color:var(--green-ink);display:block;font-family:var(--f-display);font-weight:500;font-size:clamp(1.3rem,2.4vw,1.85rem);line-height:1.1;font-variant-numeric:tabular-nums}
.stat b small{font:500 12px var(--f-mono);color:var(--muted);margin-left:3px}
.stat span{display:block;font-size:13px;color:var(--muted);margin-top:6px;line-height:1.35}
@media(max-width:560px){.stats{grid-template-columns:repeat(2,minmax(0,1fr));row-gap:6px}}
.tree-card{margin:0;background:var(--surface);border:1px solid var(--line);border-radius:12px;overflow:hidden;box-shadow:0 40px 90px -40px rgba(25,201,107,.45),0 20px 50px -30px #000}
.tree-card canvas{display:block;width:100%;height:clamp(340px,42vw,470px)}
.tree-card figcaption{border-top:1px solid var(--line);padding:12px 16px;font-size:13px;color:var(--muted);display:flex;gap:14px;align-items:baseline;flex-wrap:wrap}
.tree-card figcaption b{font:500 1.15rem var(--f-mono);color:var(--green-ink);font-variant-numeric:tabular-nums}
.tree-card figcaption span{flex:1 1 220px;min-width:0}

/* task */
.facts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(16px,3vw,40px);margin-top:36px}
@media(max-width:700px){.facts{grid-template-columns:minmax(0,1fr)}}
.fact{border-top:2px solid var(--ink);padding-top:14px}
.fact b{color:var(--green-ink);display:block;font-family:var(--f-display);font-weight:500;font-size:clamp(1.8rem,3.4vw,2.6rem);line-height:1.05;letter-spacing:-.02em}
.fact span{display:block;margin-top:8px;color:var(--muted);max-width:30ch}
.chans{display:flex;flex-wrap:wrap;gap:8px;margin-top:30px}
.chans li{list-style:none;font:500 12.5px var(--f-mono);background:var(--surface);border:1px solid var(--line);border-radius:4px;padding:6px 10px}
.chans{padding:0;margin-bottom:0}
.goal{margin-top:36px;padding:20px 22px;background:var(--purple-soft);border-radius:8px;max-width:760px}
.goal b{font-family:var(--f-mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--purple-ink);display:block;margin-bottom:8px}

/* rows */
.rowh,.row{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.5fr) minmax(0,1.2fr);gap:clamp(16px,3vw,40px)}
.rowh{font:500 11.5px var(--f-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--muted);padding-bottom:10px}
.row{border-top:1px solid var(--line);padding-block:20px}
.row h3{font-family:var(--f-display);font-weight:500;font-size:1rem;line-height:1.3}
.row .res{color:var(--green-ink);font-weight:500}
.lbl{display:none;font:500 11px var(--f-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:4px}
@media(max-width:760px){.rowh{display:none}.row{grid-template-columns:minmax(0,1fr);gap:12px}.lbl{display:block}}

/* numbers */
.nums{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:clamp(28px,5vw,72px)}
@media(max-width:900px){.nums{grid-template-columns:minmax(0,1fr)}}
.cmp{margin-bottom:34px}
.cmp h3{margin-bottom:12px}
.b{display:grid;grid-template-columns:104px minmax(0,1fr) 60px;gap:12px;align-items:center;margin-top:8px}
.b .who{font:500 12px var(--f-mono);color:var(--muted)}
.trk{height:22px;background:var(--surface);border:1px solid var(--line);border-radius:3px;overflow:hidden}
.trk i{display:block;height:100%;width:var(--w)}
.trk .old{background:var(--ghost)}
.trk .new{background:var(--green)}
.b b{font:500 1rem var(--f-mono);font-variant-numeric:tabular-nums;text-align:right}
.note{font-size:13px;color:var(--muted);margin-top:8px}
.scale{position:relative;height:96px;margin:26px 22px 0}
.scale .axis{position:absolute;left:0;right:0;top:52px;height:2px;background:var(--ink)}
.scale .tick{position:absolute;top:52px;width:1px;height:8px;background:var(--ink);left:calc(var(--v)/120*100%)}
.scale .tick em{position:absolute;top:20px;left:50%;transform:translateX(-50%);font:400 11px var(--f-mono);color:var(--muted);font-style:normal}
.scale .mk{position:absolute;left:calc(var(--v)/120*100%);top:0;transform:translateX(-50%);text-align:center;font:500 12px/1.3 var(--f-mono);white-space:nowrap}
.scale .mk::after{content:"";display:block;width:14px;height:14px;border-radius:50%;margin:8px auto 0;border:2px solid var(--surface)}
.scale .mk.a{color:var(--green-ink)}
.scale .mk.a::after{background:var(--green);box-shadow:0 0 0 1px var(--green)}
.scale .mk.p{color:var(--purple-ink)}
.scale .mk.p::after{background:var(--purple);box-shadow:0 0 0 1px var(--purple)}
.scale .mk b{display:block;font-family:var(--f-display);font-size:1.25rem;font-weight:500}
.rps{margin-top:38px;display:flex;align-items:baseline;gap:14px;flex-wrap:wrap}
.rps b{font-family:var(--f-display);font-weight:500;font-size:2.4rem;line-height:1}
.pairs{margin-top:clamp(32px,5vw,56px);border-top:1px solid var(--line)}
.pair{display:grid;grid-template-columns:150px minmax(0,1fr) minmax(0,1fr);gap:clamp(12px,3vw,32px);padding-block:16px;border-bottom:1px solid var(--line)}
.pair .k{font:500 12px var(--f-mono);letter-spacing:.06em;text-transform:uppercase;color:var(--muted);padding-top:3px}
.pair .was{color:var(--muted)}
.pair .now{font-weight:500}
.pair .now::before,.pair .was::before{display:block;font:500 11px var(--f-mono);letter-spacing:.08em;text-transform:uppercase;margin-bottom:3px}
.pair .was::before{content:attr(data-t);color:var(--muted)}
.pair .now::before{content:attr(data-t);color:var(--green-ink)}
@media(max-width:700px){.pair{grid-template-columns:minmax(0,1fr)}}

/* parallel run */
.dual{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(28px,5vw,72px);align-items:start}
@media(max-width:900px){.dual{grid-template-columns:minmax(0,1fr)}}
.lanes{position:relative;background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:22px 20px 18px}
.lane{display:grid;grid-template-columns:112px minmax(0,1fr);gap:12px;align-items:center;margin-bottom:14px}
.lane span{font:500 12px var(--f-mono);color:var(--muted)}
.ln{height:26px;border-radius:3px}
.ln.old{background:linear-gradient(90deg,var(--ghost) 0 50%,transparent 92%)}
.ln.new{background:linear-gradient(90deg,transparent 8%,var(--green) 50%)}
.ov{margin-left:124px;position:relative;height:30px;margin-top:-6px}
.ov::before{content:"";position:absolute;left:12%;right:20%;top:0;bottom:0;border-left:1px dashed var(--ink);border-right:1px dashed var(--ink);background:repeating-linear-gradient(135deg,transparent 0 6px,var(--purple-soft) 6px 8px)}
.ov span{position:absolute;left:12%;right:20%;top:50%;transform:translateY(-50%);text-align:center;font:500 11.5px var(--f-mono);color:var(--purple-ink);background:var(--surface);margin-inline:12px;padding:0 6px}
.lanes small{display:block;margin-top:6px;font:400 11px var(--f-mono);color:var(--muted)}
.steps{counter-reset:s;margin:26px 0 0;padding:0;list-style:none;display:grid;gap:14px}
.steps li{counter-increment:s;display:grid;grid-template-columns:34px minmax(0,1fr);gap:10px}
.steps li::before{content:counter(s);font:500 13px var(--f-mono);width:28px;height:28px;border-radius:50%;border:1px solid var(--ink);display:grid;place-items:center}
.big{margin-top:30px;display:flex;align-items:baseline;gap:14px;flex-wrap:wrap}
.big b{font-family:var(--f-display);font-weight:500;font-size:clamp(2.2rem,4vw,3rem);line-height:1}

/* product */
.tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:16px}
.tabs button{font:500 12.5px var(--f-mono);background:transparent;color:var(--muted);border:1px solid var(--line);border-radius:5px;padding:8px 12px;cursor:pointer}
.tabs button[aria-selected="true"]{background:var(--green);color:var(--on-green);border-color:var(--green)}
.shot{margin:0}
.shot img{display:block;width:100%;height:auto;border:1px solid var(--line);border-radius:8px;box-shadow:0 30px 70px -28px rgba(0,0,0,.85),0 0 0 1px rgba(255,255,255,.04),0 0 80px -30px rgba(25,201,107,.28)}
.shot figcaption{margin-top:12px;font-size:14px;color:var(--muted);max-width:80ch}

.frame{position:relative}
.frame .pt{position:absolute;transform:translate(-50%,-50%);width:22px;height:22px;border-radius:50%;background:#19C96B;color:#04140B;border:2px solid #0B0E14;display:grid;place-items:center;font:500 11px var(--f-mono);font-style:normal;box-shadow:0 2px 6px rgba(0,0,0,.35)}
.legend{margin:14px 0 0;padding:0;list-style:none;counter-reset:lg;display:grid;gap:8px;max-width:80ch}
.legend li{counter-increment:lg;display:grid;grid-template-columns:26px minmax(0,1fr);gap:10px;font-size:14.5px}
.legend li::before{content:counter(lg);font:500 11px var(--f-mono);width:22px;height:22px;border-radius:50%;background:var(--green);color:var(--on-green);display:grid;place-items:center}

.full{margin-top:16px;font:400 12.5px/1.5 var(--f-mono);color:var(--muted);max-width:62ch}
.three{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(20px,3vw,40px);margin-top:clamp(28px,4vw,44px)}
@media(max-width:900px){.three{grid-template-columns:minmax(0,1fr)}}
.grp{border-top:2px solid var(--ink);padding-top:14px;min-width:0}
.grp h3{font-family:var(--f-display);font-weight:500;font-size:1.02rem;line-height:1.3;margin-bottom:14px}
.grp ul{margin:0;padding:0;list-style:none;display:grid;gap:12px}
.grp li{position:relative;padding-left:18px;font-size:15px;line-height:1.5}
.grp li::before{content:"";position:absolute;left:0;top:.6em;width:7px;height:7px;background:var(--green)}
.panel.wide{grid-column:1/-1}
.budget{margin-top:18px;font-size:14px;color:var(--muted);max-width:70ch}

.hero{position:relative}
.hero::before{content:"";position:absolute;inset:0;pointer-events:none;background-image:radial-gradient(rgba(255,255,255,.07) 1px,transparent 1px);background-size:24px 24px;-webkit-mask-image:linear-gradient(180deg,#000 0,transparent 80%);mask-image:linear-gradient(180deg,#000 0,transparent 80%)}
.hero .wrap{position:relative}
.live{display:inline-flex;align-items:center;gap:8px;font:500 11px var(--f-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--green-ink);font-style:normal}
.live::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--green);animation:pulse 2s infinite}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(25,201,107,.6)}70%,100%{box-shadow:0 0 0 9px rgba(25,201,107,0)}}
@media(prefers-reduced-motion:reduce){.live::before{animation:none}}
.panel,.lanes,.trk,.chans li{box-shadow:0 1px 0 rgba(255,255,255,.03) inset}
.chans li{color:var(--ink)}
.eyebrow{display:flex;align-items:center;gap:10px}
.eyebrow::before{content:"";width:22px;height:2px;background:var(--green)}
.perks{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(18px,3vw,36px);margin-top:clamp(36px,5vw,56px)}
@media(max-width:900px){.perks{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:560px){.perks{grid-template-columns:minmax(0,1fr)}}
.perk{border-top:1px solid var(--ink);padding-top:12px}
.perk h3{margin-bottom:6px}
.perk p{font-size:15px;color:var(--muted)}

/* engine */
.eng{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(20px,3vw,40px)}
@media(max-width:900px){.eng{grid-template-columns:minmax(0,1fr)}}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:clamp(18px,2.5vw,28px);min-width:0}
.panel h3{font-family:var(--f-display);font-weight:500;font-size:1.05rem;margin-bottom:10px}
.panel p{color:var(--muted);font-size:15px}
.toks{display:flex;flex-wrap:wrap;gap:6px;margin:16px 0 4px}
.toks span{font:500 12px var(--f-mono);background:var(--bg);border:1px solid var(--line);border-radius:4px;padding:4px 8px}
.ast{width:100%;height:auto;display:block;margin-top:8px}
.ast .n{fill:var(--purple-soft);stroke:var(--purple)}
.ast .l{fill:var(--green-soft);stroke:var(--green)}
.ast line{stroke:var(--muted);stroke-width:1.2}
.ast text{font:500 11.5px var(--f-mono);fill:var(--ink);text-anchor:middle;dominant-baseline:middle}
.cap{font:400 11px var(--f-mono);color:var(--muted);margin-top:6px}
.walk{margin:14px 0 0;padding:0;list-style:none;counter-reset:w;display:grid;gap:10px}
.walk li{counter-increment:w;display:grid;grid-template-columns:28px minmax(0,1fr);gap:10px;font-size:15px}
.walk li::before{content:counter(w);font:500 12px var(--f-mono);width:24px;height:24px;border-radius:50%;background:var(--ink);color:var(--bg);display:grid;place-items:center}
.pairs2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin:16px 0}
.pairs2 b{display:block;font-family:var(--f-display);font-weight:500;font-size:1.5rem;line-height:1.1}
.pairs2 span{font-size:13px;color:var(--muted)}
.stack{display:flex;flex-wrap:wrap;gap:6px;margin-top:14px;padding:0}
.stack li{list-style:none;font:500 12px var(--f-mono);border:1px solid var(--line);background:var(--surface);border-radius:4px;padding:4px 9px}
.env{display:flex;gap:6px;margin-top:12px;flex-wrap:wrap}
.env span{font:500 12px var(--f-mono);padding:4px 9px;border-radius:4px;background:var(--purple-soft);color:var(--purple-ink)}

/* timeline */
.tl{position:relative;margin:8px 0 0;padding:0;list-style:none}
.tl li{position:relative;padding:0 0 22px 28px;border-left:2px solid var(--line);margin-left:6px}
.tl li::before{content:"";position:absolute;left:-7px;top:4px;width:12px;height:12px;border-radius:50%;background:var(--ink);border:2px solid var(--bg)}
.tl li.plan::before{background:var(--bg);box-shadow:0 0 0 1.5px var(--ghost)}
.tl li.hit::before{background:var(--green);box-shadow:0 0 0 4px var(--green-soft);width:14px;height:14px;left:-8px}
.tl time{display:block;font:500 12.5px var(--f-mono);color:var(--muted)}
.tl li.hit time{color:var(--green-ink)}
.tl strong{display:block;font-weight:600}
.tl small{display:block;color:var(--muted);font-size:13.5px}
@media(min-width:1000px){
  .tl{height:220px;margin:0 8px}
  .tl::before{content:"";position:absolute;left:0;right:0;top:108px;height:3px;background:repeating-linear-gradient(90deg,var(--ghost) 0 6px,transparent 6px 12px)}
  .tl::after{content:"";position:absolute;left:0;width:69.6%;top:108px;height:3px;background:var(--green)}
  .tl li{position:absolute;left:calc(var(--m)/27*100%);width:200px;padding:0;border:0;margin:0}
  .tl li::before{top:103px;left:-6px}
  .tl li.hit::before{top:101px;left:-7px}
  .tl li.up{bottom:122px}
  .tl li.dn{top:130px}
  .tl li.last{left:auto;right:0;text-align:right}
  .tl li.last::before{left:auto;right:-6px}
  .tl li.up{text-align:left}
}
.where{margin-top:30px;display:flex;gap:10px 18px;flex-wrap:wrap;font:500 12.5px var(--f-mono);color:var(--muted)}
.where span::before{content:"";display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--green);margin-right:7px}

/* team */
.who2{display:grid;grid-template-columns:minmax(0,1fr);gap:clamp(28px,5vw,64px)}
@media(max-width:900px){.who2{grid-template-columns:minmax(0,1fr)}}
.ppl{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:14px 18px;margin:0;padding:0;list-style:none}
.ppl li{display:grid;grid-template-columns:42px minmax(0,1fr);gap:12px;align-items:center}
