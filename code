<script>
(function(){
  /* language */
  var root=document.documentElement;
  var els=[].slice.call(document.querySelectorAll('[data-en]'));
  els.forEach(function(e){e.setAttribute('data-ru',e.innerHTML)});
  var lbls=[].slice.call(document.querySelectorAll('[data-enlabel]'));
  lbls.forEach(function(e){e.setAttribute('data-rulabel',e.getAttribute('aria-label')||'')});
  var imgs=[].slice.call(document.querySelectorAll('img[data-enalt]'));
  imgs.forEach(function(e){e.setAttribute('data-rualt',e.getAttribute('alt'))});
  var tl=[].slice.call(document.querySelectorAll('[data-t]'));
  tl.forEach(function(e){e.setAttribute('data-tru',e.getAttribute('data-t'))});
  var bru=document.getElementById('l-ru'),ben=document.getElementById('l-en');
  function setLang(l){
    root.setAttribute('lang',l);
    els.forEach(function(e){e.innerHTML=e.getAttribute(l==='en'?'data-en':'data-ru')});
    lbls.forEach(function(e){e.setAttribute('aria-label',e.getAttribute(l==='en'?'data-enlabel':'data-rulabel'))});
    imgs.forEach(function(e){e.setAttribute('alt',e.getAttribute(l==='en'?'data-enalt':'data-rualt'))});
    tl.forEach(function(e){e.setAttribute('data-t',e.getAttribute(l==='en'?'data-ten':'data-tru'))});
    bru.setAttribute('aria-pressed',l==='ru');ben.setAttribute('aria-pressed',l==='en');
    document.title='MegaRITM';
  }
  function save(l){try{localStorage.setItem('lang',l)}catch(e){}}
  bru.addEventListener('click',function(){setLang('ru');save('ru')});
  ben.addEventListener('click',function(){setLang('en');save('en')});
  var saved=null;try{saved=localStorage.getItem('lang')}catch(e){}
  var nl=((navigator.languages&&navigator.languages[0])||navigator.language||'ru').toLowerCase();
  setLang(saved||(nl.indexOf('ru')===0?'ru':'en'));

  /* tabs */
  var tabs=[0,1,2].map(function(i){return document.getElementById('t'+i)});
  var panels=[0,1,2].map(function(i){return document.getElementById('p'+i)});
  function pick(i){tabs.forEach(function(t,j){t.setAttribute('aria-selected',j===i);panels[j].hidden=j!==i})}
  tabs.forEach(function(t,i){t.addEventListener('click',function(){pick(i)});
    t.addEventListener('keydown',function(ev){var n=ev.key==='ArrowRight'?(i+1)%3:ev.key==='ArrowLeft'?(i+2)%3:-1;if(n>=0){pick(n);tabs[n].focus()}})});

  /* counter: 40 million offers a day */
  var cnt=document.getElementById('cnt'),t0=Date.now(),RATE=40e6/86400;
  function fmt(n){return new Intl.NumberFormat(root.getAttribute('lang')==='en'?'en-US':'ru-RU').format(n)}
  setInterval(function(){cnt.textContent=fmt(Math.floor((Date.now()-t0)/1000*RATE))},150);

  /* decision tree canvas */
  var cv=document.getElementById('tree');if(!cv||!cv.getContext)return;
  var ctx=cv.getContext('2d');
  var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var W=0,H=0,nw=60,nh=14,nodes=[],leaves=[],paths=[],parts=[],col={},running=true,last=0,acc=0,frame=0;
  function prng(a){return function(){a|=0;a=a+0x6D2B79F5|0;var t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}
  var R=prng(11),R2=prng(5);
  function add(level,kind,parent){var n={level:level,kind:kind,parent:parent,kids:[],x:0,y:0,flash:0,cut:0};nodes.push(n);if(parent)parent.kids.push(n);return n}
  var rootN=add(0,'root',null);
  for(var a=0;a<3;a++){var o=add(1,'o',rootN);
    var n2=1+(R()<.55?1:0);
    for(var b=0;b<n2;b++){var p=add(2,'p',o);
      var n3=R()<.6?1:2;
      for(var c=0;c<n3;c++){var q=add(3,'p',p);
        var n4=2+(R()<.5?1:0);
        for(var d=0;d<n4;d++){leaves.push(add(4,'g',q))}}}}
  leaves.forEach(function(l){var ch=[],n=l;while(n){ch.unshift(n);n=n.parent}paths.push(ch)});
  function colors(){var s=getComputedStyle(root);function g(k){return s.getPropertyValue(k).trim()}
    col={line:g('--tree-line'),root:g('--n-root'),o:g('--n-orange'),p:g('--n-purple'),g:g('--n-green'),spark:g('--spark'),bg:g('--surface'),alert:g('--alert')}}
  function layout(){
    var r=cv.getBoundingClientRect();W=r.width;H=r.height;if(!W||!H)return;
    var dpr=Math.min(window.devicePixelRatio||1,2);
    cv.width=Math.round(W*dpr);cv.height=Math.round(H*dpr);ctx.setTransform(dpr,0,0,dpr,0,0);
    var px=14,py=20;
    nw=Math.max(42,Math.min(86,(W-2*px)/6.1));
    var step=(H-2*py)/(leaves.length-1);
    nh=Math.max(10,Math.min(18,step*.66));
    var colW=(W-2*px-nw)/4;
    leaves.forEach(function(l,i){l.y=py+i*step});
    for(var lv=3;lv>=0;lv--){nodes.forEach(function(n){if(n.level===lv){var s=0;n.kids.forEach(function(k){s+=k.y});n.y=s/n.kids.length}})}
    nodes.forEach(function(n){n.x=px+n.level*colW});
  }
  function bez(a,b,t){var x0=a.x+nw,y0=a.y,x1=b.x,y1=b.y,xm=(x0+x1)/2,u=1-t;
    return [u*u*u*x0+3*u*u*t*xm+3*u*t*t*xm+t*t*t*x1,u*u*u*y0+3*u*u*t*y0+3*u*t*t*y1+t*t*t*y1]}
  function rr(x,y,w,h,r){ctx.beginPath();ctx.moveTo(x+r,y);ctx.arcTo(x+w,y,x+w,y+h,r);ctx.arcTo(x+w,y+h,x,y+h,r);ctx.arcTo(x,y+h,x,y,r);ctx.arcTo(x,y,x+w,y,r);ctx.closePath()}
  function spawn(){
    var i=Math.floor(R2()*paths.length);var cut=R2()<.4?2+Math.floor(R2()*2):-1;
    parts.push({path:paths[i],seg:0,t:0,cut:cut});rootN.flash=1}
  function step(dt){
    for(var i=parts.length-1;i>=0;i--){var p=parts[i];p.t+=dt/460;
      if(p.t>=1){var nd=p.path[p.seg+1];nd.flash=1;
        if(p.seg+1===p.cut){nd.cut=1;parts.splice(i,1)}
        else if(p.seg+1===p.path.length-1){parts.splice(i,1)}
        else{p.seg++;p.t=0}}}
    nodes.forEach(function(n){n.flash=Math.max(0,n.flash-dt/650);n.cut=Math.max(0,n.cut-dt/900)});
  }
  function draw(){
    ctx.clearRect(0,0,W,H);
    ctx.lineWidth=1;ctx.strokeStyle=col.line;
    nodes.forEach(function(n){n.kids.forEach(function(k){var x0=n.x+nw,y0=n.y,x1=k.x,y1=k.y,xm=(x0+x1)/2;ctx.beginPath();ctx.moveTo(x0,y0);ctx.bezierCurveTo(xm,y0,xm,y1,x1,y1);ctx.stroke()})});
    nodes.forEach(function(n){
      var c=n.kind==='root'?col.root:n.kind==='o'?col.o:n.kind==='p'?col.p:col.g;
      rr(n.x,n.y-nh/2,nw,nh,3);ctx.fillStyle=c;ctx.fill();
      if(n.flash>0){ctx.globalAlpha=n.flash*.42;ctx.fillStyle='#fff';ctx.fill();ctx.globalAlpha=1}
      if(n.cut>0){ctx.globalAlpha=n.cut*.85;ctx.fillStyle=col.alert;ctx.fill();ctx.globalAlpha=1}
      ctx.globalAlpha=.55;ctx.fillStyle='#fff';
      ctx.fillRect(n.x+nw*.3,n.y-nh*.2-1,nw*.5,2);ctx.fillRect(n.x+nw*.3,n.y+nh*.2-1,nw*.34,2);
      ctx.globalAlpha=1;
      if(nh>=12){ctx.fillStyle='#fff';ctx.beginPath();ctx.arc(n.x+nw*.16,n.y-nh*.2,1.7,0,6.283);ctx.fill();ctx.beginPath();ctx.arc(n.x+nw*.16,n.y+nh*.2,1.7,0,6.283);ctx.fill()}
    });
    parts.forEach(function(p){var xy=bez(p.path[p.seg],p.path[p.seg+1],p.t);
      ctx.beginPath();ctx.arc(xy[0],xy[1],3.6,0,6.283);ctx.fillStyle=col.spark;ctx.fill();ctx.lineWidth=1.6;ctx.strokeStyle=col.bg;ctx.stroke()});
  }
  function tick(ts){
    if(!running){last=0;return}
    if(!last)last=ts;var dt=Math.min(64,ts-last);last=ts;
    acc+=dt;while(acc>230){acc-=230;spawn()}
    step(dt);draw();frame++;if(frame%90===0)colors();
    requestAnimationFrame(tick);
  }
  colors();layout();
  if(window.ResizeObserver){new ResizeObserver(function(){layout();if(reduce)draw()}).observe(cv)}else{window.addEventListener('resize',function(){layout();if(reduce)draw()})}
  new MutationObserver(function(){colors();if(reduce)draw()}).observe(root,{attributes:true,attributeFilter:['data-theme']});
  if(reduce){
    for(var i=0;i<7;i++){var k=Math.floor(R2()*paths.length);parts.push({path:paths[k],seg:Math.floor(R2()*3),t:R2(),cut:-1})}
    nodes.forEach(function(n,i){if(i%5===0)n.flash=.8});draw();
  }else{
    var go=function(){if(!running){running=true;requestAnimationFrame(tick)}};
    if('IntersectionObserver' in window){new IntersectionObserver(function(es){var v=es[0].isIntersecting;if(v)go();else running=false},{threshold:0}).observe(cv)}
    requestAnimationFrame(tick);
  }
})();
</script>
